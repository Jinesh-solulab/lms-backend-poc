# Server
PORT=3000
# Public base URL used to build video/PDF download links.
# For a real phone on the same Wi-Fi use your laptop's LAN IP, e.g. http://192.168.1.20:3000
BASE_URL=http://localhost:3000

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/hs_lms

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d
# POC only: every rider logs in with this OTP
STATIC_OTP=123456

# Seeded admin (created by `npm run seed`)
ADMIN_EMAIL=admin@hs-demo.com
ADMIN_PASSWORD=Admin@123

# Local file storage (POC)
UPLOAD_DIR=./uploads
MAX_VIDEO_MB=500
MAX_PDF_MB=50

# Auto-block cron (runs every minute). Set false to disable.
DEADLINE_CRON_ENABLED=true
